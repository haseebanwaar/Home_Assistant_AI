# ============================================================================
#  Home Assistant AI — environment template
#  Copy to `.env` and fill in real values:  cp .env.example .env
#  The real .env is git-ignored; this template is safe to commit.
# ============================================================================

# --- VLM / inference server (providers/local_openAI.py) ---
VLM_BASE_URL='http://127.0.0.1:8888/v1'
VLM_API_KEY='changeme'

# --- API server (app.py) ---
APP_HOST='0.0.0.0'
APP_PORT='8000'
LOG_LEVEL='INFO'          # DEBUG for verbose frame/sentence/timing logs
DEBUG_VERBOSE='false'     # true = also stream per-stage debug/timing events to the client
MAX_FRAMES='60'           # max live stream frames attached to one request
# Qwen3.6 on llama.cpp receives JPEG image parts at captured dimensions; the
# server handles visual preprocessing and its image-token budget.
MAX_MEMORY_ITEMS='20'     # max retrieved memory snippets placed in the prompt
SCREEN_CONTEXT_WINDOWS='4' # prior compact screen observations supplied for continuity (1-8)

# --- Claude Code room runtime ---------------------------------------------
# When enabled, every room uses Claude Agent SDK's planning/tool loop. When
# disabled, every room falls back to the existing AsyncOpenAI chat.completions
# path. Rooms choose Quick/Investigate/Act depth and a graph/MCP allowlist.
AGENT_RUNTIME_ENABLED='false'
# Claude Code talks to this Anthropic-compatible endpoint. An explicitly empty
# key is supported for a trusted localhost gateway.
ANTHROPIC_BASE_URL='http://localhost:8888'
ANTHROPIC_API_KEY=''
ANTHROPIC_MODEL='Qwen/Qwen3.6-35B-A3B'
# Optional: use a particular system Claude Code binary instead of the one
# bundled by claude-agent-sdk. Worth setting if runs intermittently fail with
# "Claude Code not found at: ...\_bundled\claude.exe" while that file plainly
# exists — the SDK reports every failed spawn that way, and the bundled binary
# is replaced in place when Claude Code updates itself. A failed spawn is
# retried once automatically before the run is given up.
CLAUDE_CLI_PATH=''
# Deprecated routing values retained for old deployments; routing is now global.
AGENT_ROOM_IDS=''
AGENT_ROOM_KINDS=''
AGENT_REQUEST_LIMIT='8'    # maximum Claude agent turns in one run
AGENT_TOOL_CALLS_LIMIT='12'
RESEARCH_AGENT_REQUEST_LIMIT='32'  # SLR runs need many search/read/write turns
RESEARCH_AGENT_TOOL_CALLS_LIMIT='64'
# Minimum gap between *automatic* agent runs in one room — plan generation,
# plan evaluation and satisfaction scoring all queue behind it. Scoring falls
# back to a deterministic rule inside the gap; the user's own chat is never paced.
AGENT_ROOM_MIN_GAP_SECONDS='900'
# 04:00-05:00 is scheduler-reserved: only jobs explicitly belonging to this
# maintenance window run; interval jobs and check-ins catch up after 05:00.
MAINTENANCE_WINDOW_START_HOUR='4'
MAINTENANCE_WINDOW_END_HOUR='5'
# Job run history, so a PC that was off at 04:00 catches its maintenance up on
# the first tick after it comes back instead of skipping the night. Delete the
# file to make every job forget when it last ran.
AGENT_JOB_STATE_PATH='./data/agent_jobs.json'
# A maintenance job that fails — the graph or the model not up yet at boot —
# retries this many times before falling back to tomorrow's slot.
MAINTENANCE_RETRIES='3'
MAINTENANCE_RETRY_SECONDS='900'
# How late a *missed* run may still happen. Maintenance has no limit; these two
# review a specific day, so catching them up too late reports the wrong one.
# The report covers today, so its bound is short; a morning check-in reviews
# yesterday and stays correct into the afternoon.
DAILY_REPORT_CATCH_UP_SECONDS='3600'
AGENT_CHECKIN_CATCH_UP_SECONDS='21600'
# After the Coach's note, the nightly job also writes the day up and scores it.
# On every night, not only the nights the Reports view is opened: the score is
# only meaningful as an unbroken series, and each report is calibrated against
# the previous fortnight of them. 'false' leaves writing to the button.
DAILY_REPORT_WRITE_UP='true'
# Reasoning effort for that write-up. It reads the whole period plus two weeks
# of its own reports, so it is the one generation here worth more than 'high'.
# One of: low, medium, high, xhigh, max.
REPORT_NARRATION_EFFORT='xhigh'
TOMORROW_PLANNER_INTERVAL_SECONDS='900' # wake planner every 15 minutes
TASK_REMINDER_CHECK_SECONDS='30' # scheduler resolution; per-task delay is editable
MEMORY_CONSOLIDATION_ENABLED='true'
MEMORY_CONSOLIDATION_AT='04:05'
MEMORY_REFINEMENT_ENABLED='true'
MEMORY_REFINEMENT_AT='04:00'
MEMORY_DUPLICATE_THRESHOLD='0.88'
DAILY_REFLECTION_ENABLED='true'
DAILY_REFLECTION_AT='04:25'
DAILY_REFLECTION_PATH='./data/daily_reflections.sqlite3'
# Verify personal memory against the user's own answers, before the next set is
# written at 04:25 — so today's questions target what is still unconfirmed.
REFLECTION_MEMORY_AUDIT_ENABLED='true'
REFLECTION_MEMORY_AUDIT_AT='04:10'
REFLECTION_AUDIT_BATCH='25'      # answers verified per nightly pass
REFLECTION_AUDIT_CANDIDATES='14' # facts judged against one answer
REFLECTION_AUDIT_THINKING='true'
# Weekly pass that reads a finished week of answers as feedback about this app.
PRODUCT_REVIEW_ENABLED='true'
PRODUCT_REVIEW_AT='mon 07:00'   # weekday + local time; covers the previous week
PRODUCT_REVIEW_PATH='./data/product_reviews.sqlite3'
# Horizons: reflection and forecasting over week/month/quarter/half/year/life.
# The daily tick is almost always a no-op — it writes only windows that have
# closed — which is what lets a month boundary missed while the PC was off be
# picked up the next morning. Set after the 04:00-05:00 maintenance window so
# the night's consolidation rollups are in the graph to read.
HORIZONS_ENABLED='true'
HORIZONS_AT='07:30'
HORIZONS_PATH='./data/horizons.sqlite3'
HORIZON_REVIEWS_PER_RUN='2'    # six windows can close together (a new year does)
HORIZON_GRADE_LIMIT='25'       # forecasts judged per pass once they fall due
HORIZON_LIFE_REFRESH_DAYS='30' # the lifelong review has no window that closes
# Quran Room: every passage report, and the one deduplicated vocabulary deck
# they feed. The recall mark on each word is the user's own and is never
# rewritten by a regenerated report.
QURAN_STUDY_PATH='./data/quran_study.sqlite3'
ROOM_CANVAS_PATH='./data/room_canvases.json'
# The stated week and the dated facts that bend it (holidays, travel, sick
# days). The only record of what he *meant* to do, so a gap can be read as a
# circumstance rather than as avoidance. Written by hand only — see
# agents/calendar.py.
CALENDAR_PATH='./data/calendar.json'
# Standard MCP mcpServers JSON; see mcp.config.example.json. Empty means no MCP.
MCP_CONFIG_PATH=''
AGENT_WORKSPACE_ROOT='./agent_workspaces'  # private per-room folders live here
RESEARCH_WORKSPACE='D:/research'  # optional absolute durable research workspace
MCP_INIT_TIMEOUT_SECONDS='30'  # self-starting npx servers can exceed 5s on Windows
# The shipped MCP config starts Playwright headlessly over stdio per agent run.

# --- Screen capture (optional) ---
SCREEN_CAPTURE_ENABLED='true'
SCREEN_MONITOR_INDEX='1'  # mss monitor index; 1 is normally the primary display
SCREEN_WINDOW_SECONDS='120'
SCREEN_FPS='2.0'
SCREEN_MAX_TOKENS='18000' # completion ceiling; thinking budget remains unlimited
THINKING_MAX_TOKENS='18000' # completion ceiling for user-enabled thinking
# No keyboard or mouse for this long means the user is away: the minute is not
# captured, and the timeline stops crediting time to whatever window was left in
# front (otherwise an overlay nobody touched collects the whole night as
# "coding"). Reports count at most this much time after the last input. 0 = off.
INPUT_IDLE_TIMEOUT_SECONDS='300'
# Watching-as-presence: OFF by default (PLAYBACK_MAX_MINUTES=0), so input is
# required and nothing else counts. Turning it on lets a repainting screen stand
# in for keyboard/mouse — meant for lectures, but it cannot tell a lecture from a
# build log scrolling past an empty chair, which is how unattended hours got
# logged as work. If you do turn it on: a screen repainting at least this share of
# its pixels every second counts as presence. Measure your own screens with
# scripts/measure_screen_repaint.py and set it between "watching a video" and "the
# desk I walked away from".
PLAYBACK_CHANGE_FRACTION='0.02'
# How many minutes a busy screen may vouch for you with no input at all. 0 = never
# (the default: input is a must). Any input resets the allowance.
PLAYBACK_MAX_MINUTES='0'

# --- Proactive initiative (enabled by default across desktop, mobile, and cameras) ---
PROACTIVE_ENABLED='true'
PROACTIVE_INTERVAL_SECONDS='300'       # Claude evaluates the newest context every 5 minutes
PROACTIVE_COOLDOWN_SECONDS='300'       # minimum gap between published insights
PROACTIVE_FOCUS_COOLDOWN_SECONDS='300' # focus still uses the same high-quality gate

# --- Critical and important event notifications ---
NOTIFICATION_COOLDOWN_SECONDS='600' # suppress similar non-critical alerts per source
NOTIFICATION_STORE_PATH='./data/notifications.json'

# --- Evidence clips (sources/clips.py) ---
# Every stored capture window also writes a small, sped-up MP4, so an alert or a
# proactive nudge can be watched and asked follow-up questions about
# (GET /clips/<id>, POST /clips/<id>/ask) instead of only read.
# Retention is by consequence: a clip an alert or nudge referenced is kept for
# Both ordinary and referenced clips remain queryable for 30 days. Cleanup runs
# once daily at CLIP_PRUNE_AT. H.264 via ffmpeg when available, else OpenCV mp4v.
CLIP_CAPTURE_ENABLED='true'
CLIP_STORE_PATH='./data/clips'
CLIP_MAX_WIDTH='960'          # downscale target; height follows the aspect ratio
CLIP_PLAYBACK_FPS='3'         # a 60s window at 1 fps plays back in ~8s
CLIP_RETENTION_MINUTES='43200' # 30 days; retained for backward-compatible units
CLIP_PINNED_RETENTION_DAYS='30' # clips an alert, nudge or question referenced
CLIP_MAX_TOTAL_MB='2048'      # hard cap; evicts unpinned clips first
CLIP_PRUNE_AT='04:45'         # one cleanup per day, inside maintenance window
CLIP_CRF='23'                 # x264 quality; higher = smaller and blurrier
CLIP_ASK_MAX_TOKENS='400'     # answer budget for a question about a clip

# --- Persistent ASR server (providers/asr/parakeet_server.py) ---
PARAKEET_MODEL_PATH='C:\path\to\parakeet-tdt-0.6b-v3.nemo'
PARAKEET_MODEL_NAME='nvidia/parakeet_ctc_small' # fallback if the local model cannot load
PARAKEET_SERVER_HOST='127.0.0.1'
PARAKEET_SERVER_PORT='8765'
PARAKEET_SERVER_URL='http://127.0.0.1:8765'
PARAKEET_SERVER_TIMEOUT='120'
MOBILE_ACTIVITY_INTERVAL_SECONDS='60' # mobile frames -> memory/proactive cadence

# --- Cameras (optional) ---
# Live ONVIF cameras are auto-discovered at startup (see CAMERA_CREDENTIALS
# below). Each live camera gets its own room and is analysed by the VLM every
# CAMERA_WINDOW_SECONDS for people/vehicles/objects and events (who took what,
# when). Set CAMERA_CAPTURE_ENABLED=false to turn the whole feature off.
CAMERA_CAPTURE_ENABLED='true'
# Comma-separated camera display names that connect but start with inference paused.
CAMERA_PAUSED_BY_DEFAULT='IPC-A22E-G'
CAMERA_WINDOW_SECONDS='120'   # seconds of footage analysed per VLM pass, per camera
CAMERA_FPS='0.5'              # 60 frames per 120-second inference window
CAMERA_MAX_TOKENS='5000'     # VLM output budget per camera pass (summary + entities/claims)
# Motion gate — only run the VLM when the scene really changed (skips wind/foliage).
# Adaptive background subtraction; tune if it's too eager or too quiet:
CAMERA_MOTION_MIN_AREA='0.008'   # min moving-blob size as a fraction of the frame
CAMERA_MOTION_MIN_FRAMES='3'     # motion must persist this many frames in a window
CAMERA_MOTION_SENSITIVITY='30'   # MOG2 varThreshold; higher = less sensitive to wind
CAMERA_HEARTBEAT_MINUTES='15'    # still record a static scene every N idle windows (0=off)
# Validate before storing. Motion decides whether to spend a VLM call; this
# decides whether the answer is worth remembering. A decode glitch moves most of
# the frame and opens the gate exactly like a person would, so only the VLM's
# description reveals there was nothing there. Extractions with no claims, no
# meaningful entities, low confidence, or a distorted picture are counted against
# the camera's health (GET /cameras/health) instead of written into Rooms.
# Measured on 99 real events: 21% held real content, 79% did not.
CAMERA_MIN_CONFIDENCE='0.35'     # below this an extraction is not stored
# Persistent scene state (GET /cameras/state). Each camera tracks what is still
# true — the gate, the parked cars — with the moment it entered that state, so a
# clip says "the gate has not opened since 06:12" instead of "the gate is closed"
# for the ninetieth time. A window where every tracked thing is exactly as it was
# is counted as a confirmation and NOT written into Rooms; the periodic heartbeat
# above still records an idle scene on purpose. Transitions accumulate into
# rhythms ("the orange car usually leaves around 21:00"), which is what makes an
# absence — it has not left today — sayable at all.
CAMERA_STATE_ENABLED='true'
CAMERA_STATE_STALE_HOURS='6'     # a slot unconfirmed this long stops being carried
CAMERA_STATE_MAX_SLOTS='60'      # tracked things per camera; oldest gone ones evicted
CAMERA_STATE_HISTORY_DAYS='90'   # transition history kept for rhythm detection
# Stream selection. The lighter substream is the default for reliable continuous
# capture; set CAMERA_STREAM=main when full resolution is required.
CAMERA_STREAM='sub'              # sub | main
CAMERA_RTSP_TRANSPORT='tcp'      # tcp | udp; empty leaves OpenCV's default (udp)
CAMERA_DECODER_THREADS='2'       # open-time FFmpeg decoder thread cap; 0 = automatic
CAMERA_HW_ACCELERATION='any'     # any | none | d3d11 | vaapi | mfx
CAMERA_FLAT_FRAME_STD='8.0'      # below this grey-stddev a frame is counted (not
                                 # dropped) as blank in /cameras -> flat_frame_pct
# Explicit streams in addition to discovery (comma-separated "name|rtsp://..."),
# or a single bare CAMERA_RTSP_URL. Leave empty to rely on discovery only.
CAMERA_RTSP_URLS=''
CAMERA_RTSP_URL=''

# --- Vector store ---
QDRANT_PATH='./qdrant_db'
EMBEDDING_MODEL='BAAI/bge-small-en-v1.5'
RERANKER_MODEL='cross-encoder/ms-marco-MiniLM-L-6-v2'

# --- Single-user personal profile ---
# Learns open-ended facts from conversation and evidence-based PC-use routines.
PERSONAL_MEMORY_ENABLED=1
PERSONAL_MEMORY_PATH='./data/personal_memory.sqlite3'

# --- Orpheus TTS (providers/tts/Orpheus/orpheus.py) ---
ORPHEUS_API_URL='http://127.0.0.1:8080/v1/completions'

# --- IP camera / ONVIF credentials (utils/camera_discovery.py) ---
# Semicolon-separated user:pass pairs to try, in priority order.
CAMERA_CREDENTIALS='admin:password'
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
