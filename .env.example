# ============================================================================
#  Home Assistant AI — environment template
#  Copy to `.env` and fill in real values:  cp .env.example .env
#  The real .env is git-ignored; this template is safe to commit.
# ============================================================================

# --- VLM / inference server (providers/local_openAI.py) ---
VLM_BASE_URL='http://localhost:8000/v1'
VLM_API_KEY='changeme'

# --- API server (app.py) ---
APP_HOST='0.0.0.0'
APP_PORT='8000'
LOG_LEVEL='INFO'          # DEBUG for verbose frame/sentence/timing logs
DEBUG_VERBOSE='false'     # true = also stream per-stage debug/timing events to the client
MAX_FRAMES='20'           # max live stream frames attached to one request
# How live frames reach the model (sources/frame_budget.py). Frame count alone
# does not bound prompt size — modality does. Measured on Qwen3-VL-8B/vLLM with
# 2304x1296 camera frames: 20 frames as separate images = 57,649 tokens (over a
# 36k context), the same 20 frames as ONE video = 12,054, and 60 frames as video
# = 11,670, because the server budgets a video as a whole.
# So room chat sends its live view as a single video at full resolution, and one
# camera at a time (also required: this deployment accepts one video per prompt).
LIVE_VIDEO_FPS='1.0'          # playback rate stamped on that clip; match capture fps
# The image path is still used where video is not an option (/chat/audio live
# context, mobile activity). There, frames are downscaled to the largest
# resolution that fits this many vision tokens, and only then thinned out.
LIVE_FRAME_TOKEN_BUDGET='6000'
MAX_MEMORY_ITEMS='20'     # max retrieved memory snippets placed in the prompt

# --- Optional agent runtime (normal room chat remains direct by default) ---
# When disabled, every room continues to use the existing AsyncOpenAI
# chat.completions path. When enabled, only exact IDs/kinds listed below use
# PydanticAI's planning/tool loop; all other rooms remain direct.
AGENT_RUNTIME_ENABLED='false'
# Agent rooms also get the read-only activity-graph tools in agents/graph_tools.py.
AGENT_ROOM_IDS=''          # comma-separated, e.g. agent:phd-helper,topic:coding
AGENT_ROOM_KINDS=''        # optional comma-separated kinds; exact IDs are safer
AGENT_REQUEST_LIMIT='8'    # maximum Qwen turns in one agent run
AGENT_TOOL_CALLS_LIMIT='12'
# Standard MCP mcpServers JSON; see mcp.config.example.json. Empty means no MCP.
MCP_CONFIG_PATH=''
MCP_FILESYSTEM_ROOT='.'
# Playwright MCP: npx @playwright/mcp@latest --port 8931
MCP_BROWSER_URL='http://127.0.0.1:8931/mcp'

# --- Screen capture (optional) ---
SCREEN_CAPTURE_ENABLED='true'
SCREEN_MONITOR_INDEX='1'  # mss monitor index; 1 is normally the primary display
SCREEN_WINDOW_SECONDS='60'
SCREEN_FPS='1.0'
# No keyboard or mouse for this long means the user is away: the minute is not
# captured, and the timeline stops crediting time to whatever window was left in
# front (otherwise an overlay nobody touched collects the whole night as
# "coding"). Reports count at most this much time after the last input. 0 = off.
INPUT_IDLE_TIMEOUT_SECONDS='300'

# --- Proactive initiative (enabled by default across desktop, mobile, and cameras) ---
PROACTIVE_ENABLED='true'
PROACTIVE_COOLDOWN_SECONDS='120'       # delivery pacing, not a model judgment rule
PROACTIVE_FOCUS_COOLDOWN_SECONDS='60'  # faster pacing while a focus session is active

# --- Critical and important event notifications ---
NOTIFICATION_COOLDOWN_SECONDS='600' # suppress similar non-critical alerts per source
NOTIFICATION_STORE_PATH='./data/notifications.json'

# --- Evidence clips (sources/clips.py) ---
# Every stored capture window also writes a small, sped-up MP4, so an alert or a
# proactive nudge can be watched and asked follow-up questions about
# (GET /clips/<id>, POST /clips/<id>/ask) instead of only read.
# Retention is by consequence: a clip an alert or nudge referenced is kept for
# CLIP_PINNED_RETENTION_DAYS; every other clip is deleted after
# CLIP_RETENTION_MINUTES. H.264 via ffmpeg when it is on PATH, else OpenCV mp4v.
CLIP_CAPTURE_ENABLED='true'
CLIP_STORE_PATH='./data/clips'
CLIP_MAX_WIDTH='960'          # downscale target; height follows the aspect ratio
CLIP_PLAYBACK_FPS='3'         # a 60s window at 1 fps plays back in ~8s
CLIP_RETENTION_MINUTES='120'  # unreferenced clips
CLIP_PINNED_RETENTION_DAYS='7' # clips an alert, nudge or question referenced
CLIP_MAX_TOTAL_MB='2048'      # hard cap; evicts unpinned clips first
CLIP_PRUNE_INTERVAL_SECONDS='300'
CLIP_CRF='23'                 # x264 quality; higher = smaller and blurrier
CLIP_ASK_MAX_TOKENS='400'     # answer budget for a question about a clip

# --- Persistent ASR server (providers/asr/parakeet_server.py) ---
PARAKEET_MODEL_PATH='C:\path\to\parakeet-tdt-0.6b-v3.nemo'
PARAKEET_MODEL_NAME='nvidia/parakeet_ctc_small' # fallback if the local model cannot load
PARAKEET_SERVER_HOST='127.0.0.1'
PARAKEET_SERVER_PORT='8765'
PARAKEET_SERVER_URL='http://127.0.0.1:8765'
PARAKEET_SERVER_TIMEOUT='120'
MOBILE_ACTIVITY_INTERVAL_SECONDS='60' # mobile frames -> memory/proactive cadence

# --- Cameras (optional) ---
# Live ONVIF cameras are auto-discovered at startup (see CAMERA_CREDENTIALS
# below). Each live camera gets its own room and is analysed by the VLM every
# CAMERA_WINDOW_SECONDS for people/vehicles/objects and events (who took what,
# when). Set CAMERA_CAPTURE_ENABLED=false to turn the whole feature off.
CAMERA_CAPTURE_ENABLED='true'
CAMERA_WINDOW_SECONDS='60'   # seconds of footage analysed per VLM pass, per camera
CAMERA_FPS='1.0'
CAMERA_MAX_TOKENS='5000'     # VLM output budget per camera pass (summary + entities/claims)
# Motion gate — only run the VLM when the scene really changed (skips wind/foliage).
# Adaptive background subtraction; tune if it's too eager or too quiet:
CAMERA_MOTION_MIN_AREA='0.008'   # min moving-blob size as a fraction of the frame
CAMERA_MOTION_MIN_FRAMES='3'     # motion must persist this many frames in a window
CAMERA_MOTION_SENSITIVITY='30'   # MOG2 varThreshold; higher = less sensitive to wind
CAMERA_HEARTBEAT_MINUTES='15'    # still record a static scene every N idle windows (0=off)
# Validate before storing. Motion decides whether to spend a VLM call; this
# decides whether the answer is worth remembering. A decode glitch moves most of
# the frame and opens the gate exactly like a person would, so only the VLM's
# description reveals there was nothing there. Extractions with no claims, no
# meaningful entities, low confidence, or a distorted picture are counted against
# the camera's health (GET /cameras/health) instead of written into Rooms.
# Measured on 99 real events: 21% held real content, 79% did not.
CAMERA_MIN_CONFIDENCE='0.35'     # below this an extraction is not stored
# Stream selection. Main (default) keeps the HD picture these cameras are for.
# The substream decodes without errors but at lower resolution — opt in only if a
# given camera's decode is hopeless and picture quality matters less.
CAMERA_STREAM='main'             # main | sub
CAMERA_RTSP_TRANSPORT='tcp'      # tcp | udp; empty leaves OpenCV's default (udp)
CAMERA_FLAT_FRAME_STD='8.0'      # below this grey-stddev a frame is counted (not
                                 # dropped) as blank in /cameras -> flat_frame_pct
# FFmpeg frame-threads per camera decoder. Unset, HEVC takes one thread per core
# (24 threads for two cameras on a 12-core box) and spends most of them on
# scheduling. Raise it if flat_frame_pct climbs; 0 restores FFmpeg's own choice.
CAMERA_DECODER_THREADS='2'
# Explicit streams in addition to discovery (comma-separated "name|rtsp://..."),
# or a single bare CAMERA_RTSP_URL. Leave empty to rely on discovery only.
CAMERA_RTSP_URLS=''
CAMERA_RTSP_URL=''

# --- Vector store ---
QDRANT_PATH='./qdrant_db'
EMBEDDING_MODEL='BAAI/bge-small-en-v1.5'
RERANKER_MODEL='cross-encoder/ms-marco-MiniLM-L-6-v2'

# --- Single-user personal profile ---
# Learns open-ended facts from conversation and evidence-based PC-use routines.
PERSONAL_MEMORY_ENABLED=1
PERSONAL_MEMORY_PATH='./data/personal_memory.sqlite3'

# --- Orpheus TTS (providers/tts/Orpheus/orpheus.py) ---
ORPHEUS_API_URL='http://127.0.0.1:8080/v1/completions'

# --- IP camera / ONVIF credentials (utils/camera_discovery.py) ---
# Semicolon-separated user:pass pairs to try, in priority order.
CAMERA_CREDENTIALS='admin:password'
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
